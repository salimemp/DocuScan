#!/usr/bin/env bash
# .githooks/pre-commit — DocScan Pro pre-commit guard
#
# Purpose: stop two classes of bad commit before they enter history.
#   1. Junk auto-commit messages (the "auto-commit for <uuid>" pattern that
#      polluted history with 428 low-information commits).
#   2. Accidentally-committed secrets (Gemini, Stripe, Resend, Turnstile,
#      Emergent, JWT_SECRET, etc.).
#
# Enable:  git config core.hooksPath .githooks
# Disable: git config --unset core.hooksPath
#
# This hook intentionally runs in pure bash with no external deps so it
# works on every contributor's machine without extra install steps.

set -euo pipefail

# ── 1. Scan staged content for secrets ─────────────────────────────────────
# We grep the *staged* content (what's about to be committed), not the
# whole working tree. This catches new secrets even if .env was already
# in the tree from a prior commit.

staged_files() {
  git diff --cached --name-only --diff-filter=ACM
}

secret_patterns=(
  # Google Gemini / AI Studio API keys (AIzaSy...)
  'AIza[0-9A-Za-z_-]{30,}'
  # Stripe live/test secret keys (sk_live_... / sk_test_...)
  'sk_(live|test)_[0-9A-Za-z]{16,}'
  # Stripe restricted keys
  'rk_(live|test)_[0-9A-Za-z]{16,}'
  # Resend API keys
  're_[0-9A-Za-z]{20,}'
  # Emergent LLM keys (em_...)
  'em_[0-9A-Za-z]{20,}'
  # Cloudflare Turnstile secret keys (0x4AAA...)
  '0x[0-9A-Za-z_-]{30,}'
  # JWT / generic Bearer / HS256 secrets with reasonable entropy
  'eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'
  # AWS access keys
  'AKIA[0-9A-Z]{16}'
  # Generic private key block
  '-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'
)

fail=0
files_to_scan=$(staged_files)
if [ -n "$files_to_scan" ]; then
  for pattern in "${secret_patterns[@]}"; do
    # `-I` skips binary files; `--no-messages` suppresses "Binary file matches".
    matches=$(git diff --cached -I '' --no-color -- \
      $(printf -- '-- %s ' $files_to_scan) 2>/dev/null \
      | grep -E "^\+.*${pattern}" \
      | grep -v '^\+\+\+' || true)
    if [ -n "$matches" ]; then
      echo "❌ Secret pattern '${pattern}' detected in staged changes:" >&2
      echo "$matches" | head -5 >&2
      fail=1
    fi
  done
fi

# ── 2. Block .env from being committed (defence-in-depth) ─────────────────
# .env is already in .gitignore, but if someone has force-added it we
# catch it here so the secret-leak path above doesn't matter.
for f in $(staged_files); do
  base=$(basename "$f")
  if [ "$base" = ".env" ] || [[ "$base" == .env.* && "$base" != ".env.example" ]]; then
    echo "❌ Refusing to commit $f — .env files must never enter git." >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked. To override (DANGEROUS — be sure of what you're doing):" >&2
  echo "  git commit --no-verify" >&2
  exit 1
fi

exit 0