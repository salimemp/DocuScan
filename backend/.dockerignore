# Keep Docker image small and clean

# Python bytecode / caches
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
.env/

# Local env files (secrets injected via Railway UI instead)
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Git metadata
.git
.gitignore
.github/

# Tests (not needed in runtime image)
tests/
test_*.py
*_test.py

# Documentation
README.md
*.md
!requirements.txt

# Temporary
tmp/
temp/
*.tmp

# Node modules (for monorepo safety)
node_modules/

# Frontend files (backend Dockerfile shouldn't include them)
../frontend/
