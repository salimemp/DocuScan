# Environment variables required by the DocScan Pro backend
# Copy this file to .env and fill in your actual values.
# On Railway, set these via: Project → Variables → Raw editor

# MongoDB connection string (Atlas recommended for production)
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"
DB_NAME="docscanpro_prod"

# CORS: comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS="*"

# AI / LLM Keys
GEMINI_API_KEY=""
EMERGENT_LLM_KEY=""

# Email (Resend.com)
RESEND_API_KEY=""

# Bot protection (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# JWT / Auth secrets
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="43200"

# App metadata (optional)
APP_NAME="DocScan Pro"
APP_ENV="production"
