# Environment variables required by the DocScan Pro backend
# Copy this file to .env and fill in your actual values.
# On Railway, set these via: Project → Variables → Raw editor

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Atlas (recommended for production):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local dev:
#   mongodb://localhost:27017
MONGO_URL="mongodb://localhost:27017"
DB_NAME="docscanpro_prod"

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS="*"

# ─── AI / LLM ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
EMERGENT_LLM_KEY=""

# ─── Email (Resend.com) ─────────────────────────────────────────────────────
RESEND_API_KEY=""

# ─── Bot protection (Cloudflare Turnstile) ─────────────────────────────────
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# ─── JWT / Auth secrets ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="43200"

# ─── App metadata ──────────────────────────────────────────────────────────
APP_URL="https://docscanpro.app"
APP_ENV="production"

# ─── Image storage ─────────────────────────────────────────────────────────
# Backend selection:
#   "inline"  → store base64 in the MongoDB document (default; no setup)
#   "r2"      → Cloudflare R2 (recommended; zero egress fees)
#   "s3"      → AWS S3 / MinIO / Backblaze B2
STORAGE_BACKEND="inline"

# R2 / S3 configuration (only required if STORAGE_BACKEND is r2 or s3).
# See memory/R2_STORAGE_GUIDE.md for the full step-by-step setup.
#
# S3_BUCKET              — bucket name (e.g. "docscan-prod")
# S3_REGION              — "auto" for R2, "us-east-1" for AWS S3
# S3_ENDPOINT_URL        — required for R2/MinIO/B2; leave empty for AWS S3.
#                          R2 format: https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID       — IAM access key (R2: API token with Object Read & Write)
# S3_SECRET_ACCESS_KEY   — IAM secret key
# S3_PUBLIC_BASE_URL     — (optional) public CDN base. If your R2 bucket has
#                          a custom domain like media.docscanpro.app, set this
#                          to it and the helper skips presigned URLs.
#                          Leave empty to use signed URLs (1h TTL).
# S3_SIGNED_URL_TTL      — (optional) seconds; default 3600 (1h)
#
# Example R2 values (DO NOT commit real keys):
# STORAGE_BACKEND="r2"
# S3_BUCKET="docscan-prod"
# S3_REGION="auto"
# S3_ENDPOINT_URL="https://0123456789abcdef.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="<your-r2-access-key-id>"
# S3_SECRET_ACCESS_KEY="<your-r2-secret-access-key>"
# S3_PUBLIC_BASE_URL="https://media.docscanpro.app"